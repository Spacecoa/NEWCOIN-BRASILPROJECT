# Copie para .env e ajuste. Todos os valores são para ambiente LOCAL de pesquisa.
PORT=4000
DATABASE_URL=postgres://social:social@localhost:5432/social
# Opcional: sem REDIS_URL o backend usa apenas SQL (fan-out on read).
REDIS_URL=redis://localhost:6379
# Segredo que assina os tokens de acesso. Vazio em desenvolvimento = um aleatório a cada início.
# Fora da sua máquina é obrigatório: gere com `openssl rand -hex 32`. Valores curtos ou de
# exemplo fazem o servidor recusar iniciar.
JWT_SECRET=
# Sessão: token de acesso de 15 min, renovado por até 30 dias pelo cookie HttpOnly.
# ACCESS_TOKEN_TTL_SEC=900
# SESSION_TTL_DAYS=30
# Ligue em HTTPS para o cookie de sessão só trafegar com cadeado.
# COOKIE_SECURE=true
# Atrás de proxy reverso (nginx, Caddy): quantos saltos confiar para ler o IP real.
# Use o número de proxies ou a lista de IPs deles. "true" confia em qualquer X-Forwarded-For
# e anula os limites por IP: fora de produção o servidor não inicia com ele.
# TRUST_PROXY=1
# Limite geral da API por pessoa (ou IP sem login), por janela de 5 min.
# API_RATE_LIMIT=600
# Contas que moderam a instância (usernames separados por vírgula), promovidas ao iniciar.
# Só contas que já existem. Um nome que ainda não existe fica anotado e, se alguém o
# cadastrar depois, NÃO é promovido sozinho: use `npm run moderacao:promover -- <usuario>`.
# MODERATORS=ana_dev
# Senha das contas do seed (npm run seed). Em domínio local é "senha1234"; em qualquer outro
# domínio (pré-produção na rede), vem daqui ou é sorteada e mostrada uma vez. O seed APAGA o
# banco e não roda com NODE_ENV=production.
# SEED_PASSWORD=
# Aba "Brasil em dados": por padrão mostra o registro conferido à mão (src/official/registro.js)
# e não busca nada sozinha. Para buscar as APIs do IBGE e do Banco Central de tempos em tempos,
# informe o intervalo em minutos; o servidor precisa alcançar servicodados.ibge.gov.br e api.bcb.gov.br.
# OFFICIAL_DATA_REFRESH_MIN=360
# Tempo máximo de cada consulta ao banco (ms).
# DB_STATEMENT_TIMEOUT_MS=5000
# Domínio da instância — usado em handles federados (usuario@dominio) e URIs.
INSTANCE_DOMAIN=localhost:4000
# Worker ID do gerador Snowflake (0–1023). Instâncias diferentes => IDs diferentes.
WORKER_ID=1
CORS_ORIGIN=http://localhost:5173

# Recuperar senha: o link do e-mail aponta para WEB_URL (padrão: CORS_ORIGIN). No protótipo
# o e-mail não é enviado de verdade: MAIL_TRANSPORT=log escreve o e-mail no log do servidor.
# WEB_URL=http://localhost:5173
# MAIL_TRANSPORT=log

# Token interno (sem valor monetário)
TOKEN_NAME=NewCoin
TOKEN_SYMBOL=NWC
# Fuso que define o "dia" das missões
MISSION_TZ=America/Sao_Paulo

# Robustez (docs/10)
# Distribuir posts para os seguidores por uma fila no Redis (1, padrão) ou dentro do pedido (0).
# FANOUT_QUEUE=1
# Painel coletivo das missões: recalculado no máximo a cada N segundos (igual para todos).
# MISSIONS_COLLECTIVE_CACHE_SEC=60
# GET /api/metricas (formato Prometheus) só existe com este token, enviado como Authorization: Bearer.
# METRICS_TOKEN=
