# Copie para .env e ajuste. Todos os valores são para ambiente LOCAL de pesquisa.
PORT=4000
DATABASE_URL=postgres://social:social@localhost:5432/social
# Opcional: sem REDIS_URL o backend usa apenas SQL (fan-out on read).
REDIS_URL=redis://localhost:6379
# Segredo que assina os tokens de acesso. Vazio em desenvolvimento = um aleatório a cada início.
# Fora da sua máquina é obrigatório: gere com `openssl rand -hex 32`. Valores curtos ou de
# exemplo fazem o servidor recusar iniciar.
JWT_SECRET=
# Sessão: token de acesso de 15 min, renovado por até 30 dias pelo cookie HttpOnly.
# ACCESS_TOKEN_TTL_SEC=900
# SESSION_TTL_DAYS=30
# Ligue em HTTPS para o cookie de sessão só trafegar com cadeado.
# COOKIE_SECURE=true
# Atrás de proxy reverso (nginx, Caddy): quantos saltos confiar para ler o IP real.
# TRUST_PROXY=1
# Limite geral da API por pessoa (ou IP sem login), por janela de 5 min.
# API_RATE_LIMIT=600
# Contas que moderam a instância (usernames separados por vírgula), promovidas ao iniciar.
# MODERATORS=ana_dev
# Aba "Brasil em dados": de quanto em quanto tempo buscar as fontes oficiais (minutos; 0 desliga).
# O servidor precisa alcançar servicodados.ibge.gov.br e api.bcb.gov.br.
# OFFICIAL_DATA_REFRESH_MIN=360
# Tempo máximo de cada consulta ao banco (ms).
# DB_STATEMENT_TIMEOUT_MS=5000
# Domínio da instância — usado em handles federados (usuario@dominio) e URIs.
INSTANCE_DOMAIN=localhost:4000
# Worker ID do gerador Snowflake (0–1023). Instâncias diferentes => IDs diferentes.
WORKER_ID=1
CORS_ORIGIN=http://localhost:5173

# Token interno (sem valor monetário)
TOKEN_NAME=NewCoin
TOKEN_SYMBOL=NWC
# Fuso que define o "dia" das missões
MISSION_TZ=America/Sao_Paulo
