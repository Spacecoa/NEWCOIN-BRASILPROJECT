# Copie para .env e ajuste. Todos os valores são para ambiente LOCAL de pesquisa.
PORT=4000
DATABASE_URL=postgres://social:social@localhost:5432/social
# Opcional: sem REDIS_URL o backend usa apenas SQL (fan-out on read).
REDIS_URL=redis://localhost:6379
JWT_SECRET=troque-este-segredo-em-qualquer-ambiente-compartilhado
# Domínio da instância — usado em handles federados (usuario@dominio) e URIs.
INSTANCE_DOMAIN=localhost:4000
# Worker ID do gerador Snowflake (0–1023). Instâncias diferentes => IDs diferentes.
WORKER_ID=1
CORS_ORIGIN=http://localhost:5173
